# Local MySQL setup. Import database/sun_son_solar.sql, then database/stakeholder_portal.sql.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost/Sun-Son-Solar/public/'

database.default.hostname = 127.0.0.1
database.default.database = sun_son_solar_local
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false

# If your XAMPP MySQL root account has a password, enter it above.
# These credentials are for local development only.
